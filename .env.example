# Application and logging
APP_NAME=PolicySage
APP_ENV=production
LOG_LEVEL=INFO

# OpenAI models and credentials
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Qdrant vector database
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=
QDRANT_COLLECTION=insurance-kb
QDRANT_API_KEY=

# Managed knowledge base and Neon PostgreSQL
KB_MANAGED=true
KB_DATABASE_URL=
KB_DIR=data/kb

# S3-compatible document storage
KB_S3_ENDPOINT=
KB_S3_REGION=
KB_S3_BUCKET=
KB_S3_ACCESS_KEY_ID=
KB_S3_SECRET_ACCESS_KEY=

# Admin access and public downloads
ADMIN_API_KEY=
KB_ADMIN_USERNAME=admin
KB_ADMIN_PASSWORD=
PUBLIC_CHAT_ENABLED=true
PUBLIC_PDF_DOWNLOADS_ENABLED=false

# Web search providers
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# Retrieval and request limits
TOP_K=10
MAX_RETRIES=2
REQUEST_TIMEOUT=60
CHAT_TIMEOUT=180
MAX_SEARCHES_PER_CHAT=6
MAX_WEB_ATTEMPTS_PER_CHAT=4
MAX_CONCURRENT_CHATS=2
CHAT_REQUESTS_PER_MINUTE=6
DAILY_CHAT_LIMIT=30
MONTHLY_CHAT_LIMIT=300

# Prompt and response token budgets
MAX_REQUEST_TOKENS=72000
MAX_PROMPT_TOKENS=14000
MAX_HISTORY_TOKENS=2000
MAX_QUESTION_TOKENS=1024
MAX_EVIDENCE_TOKENS=8000
MAX_ANSWER_TOKENS=1500

# Document chunk sizes in tokens
CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=90
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=650

# Local data paths
AUDIT_DB_PATH=data/audit.db
USAGE_DB_PATH=data/usage.db
SEMANTIC_CACHE_PATH=data/semantic_cache.db

# LangSmith tracing
LANGSMITH_ENABLED=false
LANGSMITH_DEBUG_CONTENT=false
LANGSMITH_TRACE_SAMPLE_RATE=1.0
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=policysage
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
